@model (HeroSection Section, List<SkillGetDtoHero> Skills)

<section id="home"
         class="flex-grow flex flex-col items-center justify-center text-center max-w-5xl mx-auto w-full space-y-8 mt-16">
    <!-- Decorative accent line -->
    <div class="w-px h-24 bg-gradient-to-b from-transparent via-primary/50 to-transparent mb-4"></div>
    <!-- Main Title -->
    <div class="relative group cursor-default">
        <!-- Glowing effect behind text -->
        <div class="absolute -inset-8 bg-primary/20 blur-3xl rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-700">
        </div>
        <h1 class="relative font-serif text-7xl md:text-9xl lg:text-[10rem] font-bold tracking-tight text-white/95 leading-none select-none text-glow mix-blend-screen">
            @Model.Section.Title
        </h1>
    </div>
    <!-- Subtitle/Role -->
    <div class="space-y-4 max-w-2xl relative">
        <h2 class="text-sm md:text-base lg:text-lg uppercase tracking-[0.3em] text-primary/80 font-semibold mb-2">
            @Model.Section.SubTitle
        </h2>
        <p class="text-xl md:text-3xl font-light text-slate-300 font-display">
            <span class="text-white font-medium">@Model.Section.Role</span>
        </p>
        <p class="text-md font-light text-slate-300 font-display">
            @Model.Section.SubRole
        </p>
        <p class="text-sm text-slate-400 max-w-md mx-auto leading-relaxed pt-4 opacity-80">
            @Model.Section.Description
        </p>
    </div>
    <!-- Tech Stack Pills (Subtle) -->
    <div class="flex flex-wrap justify-center gap-3 pt-8 transition-opacity duration-500">
        @foreach (var item in Model.Skills)
        {
            <span class="px-3 py-1 text-xs border border-white/10 transition-all select-none opacity-60 hover:opacity-100
            rounded-full text-slate-400 bg-white/5 backdrop-blur-sm">@item.Name</span>
        }
    </div>
    <div class="flex-none pb-8 floating-element">
        <a class="flex flex-col items-center gap-2 text-slate-500 hover:text-primary transition-colors duration-300 group"
           href="#about">
            <span class="text-[10px] uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                Scroll
                Down
            </span>
            <div class="w-6 h-10 border-2 border-slate-600/50 rounded-full flex justify-center p-1 group-hover:border-primary/50 transition-colors">
                <div class="w-1 h-2 bg-slate-400 rounded-full group-hover:bg-primary transition-colors animate-bounce">
                </div>
            </div>
        </a>
    </div>
    <!-- Left Side Decoration (Rotated Text) -->
    <div class="hidden lg:block absolute left-8 bottom-32 z-20 origin-bottom-left -rotate-90">
        <span class="text-xs font-mono text-slate-500 tracking-widest">EST. 2026 — TURKIYE</span>
    </div>
</section>
