@model Portfolio.Entity.Concrete.ContactSection

<section id="contact"
         class="relative z-10 flex-grow flex items-center justify-center py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl w-full">
        <!-- Section Header -->
        <div class="text-center mb-16">
            <span class="inline-block py-1 px-3 rounded-full bg-primary/10 border border-primary/20 text-primary text-sm font-semibold tracking-wider uppercase mb-4">
                Availability: @if (Model.OpenToWork)
                {
                    <span class="text-white opacity-80">Open To Work</span>
                }
                                else
                {
                    <span class="text-red-400 opacity-80">Focused on Growth</span>
                }
            </span>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 tracking-tight">
                @Model.Title
            </h1>
            <p class="max-w-2xl mx-auto text-lg text-slate-400">
                @Model.Description
            </p>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
            <!-- Left Column: Contact Info -->
            <div class="lg:col-span-5 space-y-6">
                <!-- Info Card -->
                <div class="glass-panel rounded-xl p-8 relative overflow-hidden group hover:border-primary/30 transition-colors duration-300">
                    <div class="absolute top-0 right-0 p-8 opacity-10 group-hover:opacity-20 transition-opacity">
                        <span class="material-icons-outlined text-9xl text-white">connect_without_contact</span>
                    </div>
                    <h3 class="text-2xl font-bold text-white mb-8 relative z-10">Contact Details</h3>
                    <div class="space-y-8 relative z-10">
                        <!-- Email -->
                        <div class="flex items-start group/item">
                            <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center text-primary group-hover/item:bg-primary group-hover/item:text-white transition-all duration-300">
                                <span class="material-icons-outlined">email</span>
                            </div>
                            <div class="ml-4">
                                <p class="text-sm font-medium text-slate-400">Email Me</p>
                                <a class="text-lg font-semibold text-white hover:text-primary transition-colors"
                                   href="mailto:hello@baris.dev">@Model.Email</a>
                            </div>
                        </div>
                        <!-- Phone -->
                        <div class="flex items-start group/item">
                            <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center text-primary group-hover/item:bg-primary group-hover/item:text-white transition-all duration-300">
                                <span class="material-icons-outlined">phone_iphone</span>
                            </div>
                            <div class="ml-4">
                                <p class="text-sm font-medium text-slate-400">Call Me</p>
                                <p class="text-lg font-semibold text-white">@Model.Phone</p>
                            </div>
                        </div>
                        <!-- Location -->
                        <div class="flex items-start group/item">
                            <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center text-primary group-hover/item:bg-primary group-hover/item:text-white transition-all duration-300">
                                <span class="material-icons-outlined">location_on</span>
                            </div>
                            <div class="ml-4">
                                <p class="text-sm font-medium text-slate-400">Location</p>
                                <p class="text-lg font-semibold text-white">@Model.Location</p>
                            </div>
                        </div>
                    </div>
                </div>
                
            </div>
            <!-- Right Column: Contact Form -->
            <div class="lg:col-span-7 items-center justify-center flex">
                <!-- Map/Visual Element -->
                <div class="glass-panel rounded-xl h-64 relative overflow-hidden group w-[70%]">
                    <!-- Abstract Map Representation -->
                    <img alt="Map View"
                         class="w-full h-full object-cover opacity-60 group-hover:opacity-80 group-hover:scale-105 transition-all duration-500 grayscale hover:grayscale-0"
                         src="@Model.MapImageUrl" />
                    <div class="absolute inset-0 bg-gradient-to-t from-background-dark via-transparent to-transparent opacity-90">
                    </div>
                    <div class="absolute bottom-6 left-6">
                        <p class="text-xs font-mono text-primary mb-1">CURRENTLY BASED IN</p>
                        <p class="text-xl font-bold text-white flex items-center gap-2">
                            @Model.MapLocation
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>