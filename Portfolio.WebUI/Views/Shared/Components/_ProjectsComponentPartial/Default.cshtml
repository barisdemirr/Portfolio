@model (ProjectsSection Section, List<ProjectGetDto> Projects)

<section id="projects"
         class="relative pt-32 pb-24 px-4 sm:px-6 lg:px-8 bg-midnight-gradient overflow-hidden min-h-screen">

    <div class="relative max-w-7xl mx-auto">
        <!-- Section Header -->
        <div class="mb-16 md:flex md:items-end md:justify-between">
            <div class="max-w-2xl">
                <h2 class="text-primary font-medium tracking-wide text-sm uppercase mb-3">@Model.Section.SurTitle</h2>
                <h1 class="text-4xl md:text-5xl font-bold text-white tracking-tight mb-4">
                    @Model.Section.Title
                </h1>
                <p class="text-lg text-slate-400 leading-relaxed">
                    @Model.Section.Description
                </p>
            </div>
            <div class="hidden md:block mt-4 md:mt-0">
                <a class="group inline-flex items-center text-slate-400 hover:text-primary transition-colors" target="_blank"
                   href="@Model.Section.GithubUrl">
                    View GitHub Profile
                    <span class="material-icons ml-1 text-lg group-hover:translate-x-1 transition-transform">arrow_forward</span>
                </a>
            </div>
        </div>
        <!-- Projects Grid -->
        <div class="w-full">
            <div id="project-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

                @foreach (var project in Model.Projects)
                {
                    <article class="project-item group relative flex flex-col bg-card-glass hover:bg-card-glass-hover rounded-xl border border-white/10 transition-all duration-300 hover:-translate-y-2 overflow-hidden">
                        <div class="relative h-56 w-full overflow-hidden border-b border-white/5">
                            <div class="absolute inset-0 bg-primary/20 group-hover:bg-transparent transition-colors z-10">
                            </div>
                            <img alt="Dashboard"
                                 class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500 opacity-80 group-hover:opacity-100"
                                 src="@project.ImageUrl" />
                        </div>
                        <div class="p-6 flex flex-col flex-grow">
                            <div class="mb-4">
                                <h3 class="text-xl font-bold text-white mb-2 group-hover:text-primary-light transition-colors">
                                    @project.Title
                                </h3>
                                <p class="text-slate-400 text-sm leading-relaxed line-clamp-3">
                                    @project.Description
                                </p>
                            </div>
                            <div class="mt-auto">
                                <div class="flex flex-wrap gap-2 mb-6">
                                    @foreach (var tech in project.TechStack.Split(", "))
                                    {
                                        <span class="px-3 py-1 text-xs font-medium text-primary-light bg-primary/10 border border-primary/20 rounded-full">@tech.Trim()</span>
                                    }
                                </div>
                                <div class="flex items-center gap-3 pt-4 border-t border-white/5">
                                    <a class="flex-1 inline-flex justify-center items-center gap-2 px-4 py-2 hover:bg-white/10 text-sm font-medium rounded-lg border border-white/10 transition-all @(project.IsGithubActive ? "bg-white/5 text-white" : "text-gray-400 opacity-50 pointer-events-none")"
                                       href="@(project.IsGithubActive ? project.GithubLink : "")">Source</a>
                                    <a class="flex-1 inline-flex justify-center items-center gap-2 px-4 py-2  text-sm font-medium rounded-lg border border-white/10 transition-all @(project.IsDeployed ? "bg-primary hover:bg-primary-light text-white shadow-lg shadow-primary/20" : "text-gray-400 opacity-50 pointer-events-none")"
                                       href="@(project.IsDeployed ? project.DeployLink: "")">Go Website</a>
                                </div>
                            </div>
                        </div>
                    </article>
                }

                


            </div>

            <div id="project-pagination-controls" class="flex justify-center items-center gap-4 mt-12">
                <button id="project-prev-btn"
                        class="w-10 h-10 flex items-center justify-center rounded-lg bg-white/5 border border-white/10 text-white hover:bg-primary/20 transition-all disabled:opacity-20 disabled:cursor-not-allowed">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M15 19l-7-7 7-7"></path>
                    </svg>
                </button>

                <div id="project-page-numbers" class="flex gap-2"></div>

                <button id="project-next-btn"
                        class="w-10 h-10 flex items-center justify-center rounded-lg bg-white/5 border border-white/10 text-white hover:bg-primary/20 transition-all disabled:opacity-20 disabled:cursor-not-allowed">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 5l7 7-7 7"></path>
                    </svg>
                </button>
            </div>

        </div>
        <!-- Mobile Footer Link -->
        <div class="md:hidden mt-12 text-center">
            <a class="inline-flex items-center text-slate-400 hover:text-white transition-colors" href="#">
                See all projects on GitHub
                <span class="material-icons ml-1 text-lg">arrow_forward</span>
            </a>
        </div>
    </div>
</section>