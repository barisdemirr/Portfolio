@model (AboutSection Section, List<SkillGetDto> Skills)

<section id="about"
         class="w-full max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12 relative z-10 mt-12">
    <!-- Left Column: About & Bio -->
    <div class="lg:col-span-5 flex flex-col gap-8">
        <!-- Header -->
        <div class="space-y-4">
            <div class="flex items-center gap-3">
                <span class="h-px w-12 bg-primary"></span>
                <span class="text-primary font-medium tracking-widest text-sm uppercase">@Model.Section.SurTitle</span>
            </div>
            <h1 class="text-5xl md:text-6xl font-bold text-slate-900 dark:text-white leading-tight">
                @Model.Section.Title
            </h1>
        </div>
        <!-- Bio Card -->
        <div class="glass-panel rounded-xl p-8 shadow-2xl relative overflow-hidden group">
            <div class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-full blur-2xl -translate-y-1/2 translate-x-1/2 group-hover:bg-primary/10 transition-colors duration-500">
            </div>
            <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
                @Model.Section.Description
            </p>
            <p class="text-slate-500 dark:text-slate-400 leading-relaxed">
                @Model.Section.SubDescription
            </p>
            <div class="mt-8 pt-8 border-t border-slate-200 dark:border-slate-700/50 flex flex-wrap gap-4">
                <a class="inline-flex items-center gap-2 text-sm font-medium text-white bg-primary hover:bg-primary/90 px-6 py-3 rounded-lg transition-all shadow-lg hover:shadow-primary/25"
                   href="@Model.Section.CvUrl">
                    <span>Download CV</span>
                    <span class="material-icons-outlined text-lg">download</span>
                </a>
            </div>
        </div>
        <!-- Education Section -->
        <div class="space-y-4">
            <h3 class="text-xl font-semibold text-slate-900 dark:text-white flex items-center gap-2">
                <span class="material-icons-outlined text-primary">school</span>
                Education
            </h3>
            <div class="glass-panel rounded-xl p-6 border-l-4 border-l-primary flex items-start gap-4">
                <div class="p-3 bg-primary/10 rounded-lg text-primary shrink-0">
                    <span class="material-icons-outlined text-2xl">account_balance</span>
                </div>
                <div>
                    <h4 class="text-lg font-bold text-slate-900 dark:text-white">@Model.Section.EducationDepartment</h4>
                    <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">
                        @Model.Section.EducationCollege
                        • @Model.Section.EducationDate
                    </p>
                    <p class="text-slate-500 dark:text-slate-400 text-sm mt-2 opacity-80">
                        @Model.Section.EducationDescription
                    </p>
                </div>
            </div>
        </div>
    </div>
    <!-- Right Column: Technical Stack Image & Stats -->
    <div class="lg:col-span-7 flex flex-col justify-center h-full">
        <!-- Stack Introduction -->
        <div class="mb-8 lg:pl-8">
            <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-2">@Model.Section.TechTitle</h2>
            <p class="text-slate-500 dark:text-slate-400">
                @Model.Section.TechDescription
            </p>
        </div>
        <div class="lg:pl-8">
            <div id="skill-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">

                @foreach (var skill in Model.Skills)
                {
                    <div class="skill-card glass-panel p-6 rounded-xl hover:-translate-y-1 transition-all duration-300 group border-b-2 border-transparent hover:border-primary">
                        <div class="flex justify-between items-start mb-4">
                            <div class="w-12 h-12 rounded-lg bg-[#512BD4]/10 flex items-center justify-center group-hover:bg-[#512BD4]/20 transition-colors">
                                <svg class="w-7 h-7 text-[#512BD4] dark:text-[#9b7add]" fill="currentColor"
                                     viewbox="0 0 24 24">
                                    <path d="M23.954 12.639l-5.748 8.917L12 24l-6.206-2.444L0 12.639l6.586-3.87 5.414 8.783 5.414-8.783 6.54 3.87zM12 0l4.322 3.197L12 6.395 7.678 3.197 12 0z">
                                    </path>
                                </svg>
                            </div>
                            <span class="text-2xl font-bold text-slate-900 dark:text-white">@skill.ProgressValue%</span>
                        </div>
                        <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-3">@skill.Name</h3>
                        <div class="w-full bg-slate-200 dark:bg-slate-700/30 rounded-full h-1.5 overflow-hidden">
                            <div class="bg-primary h-1.5 rounded-full shadow-[0_0_10px_rgba(17,50,212,0.6)] w-[@skill.ProgressValue%] relative overflow-hidden">
                                <div class="absolute inset-0 bg-white/20 w-full h-full animate-[shimmer_2s_infinite]">
                                </div>
                            </div>
                        </div>
                        <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">
                            @skill.Description
                        </p>
                    </div>
                }
                
            </div>

            <div id="pagination-controls" class="flex justify-center items-center gap-4 mt-10">
                <button id="prev-btn"
                        class="w-10 h-10 flex items-center justify-center rounded-lg bg-white/5 border border-white/10 text-white hover:bg-primary/20 transition-all disabled:opacity-20 disabled:cursor-not-allowed">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M15 19l-7-7 7-7"></path>
                    </svg>
                </button>

                <div id="page-numbers" class="flex gap-2">
                </div>

                <button id="next-btn"
                        class="w-10 h-10 flex items-center justify-center rounded-lg bg-white/5 border border-white/10 text-white hover:bg-primary/20 transition-all disabled:opacity-20 disabled:cursor-not-allowed">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewbox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 5l7 7-7 7"></path>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</section>