@model List<ProjectGetAdminDto>

@{
    Layout = "~/Areas/Admin/Views/Shared/_PanelLayout.cshtml";
}

<div class="max-w-5xl mx-auto">

    <div class="mb-8">
        <h1 class="text-2xl font-semibold text-slate-800">Projects Management</h1>
        <p class="text-slate-500 mt-1">Manage the portfolio projects displayed on your site.</p>
    </div>

    <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden mb-6">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 border-b border-slate-200">
                    <th class="px-6 py-4 text-sm font-medium text-slate-500">Title</th>
                    <th class="px-6 py-4 text-sm font-medium text-slate-500">Description</th>
                    <th class="px-6 py-4 text-sm font-medium text-slate-500">Tech Stack</th>
                    <th class="px-6 py-4 text-sm font-medium text-slate-500 text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="border-b border-slate-100 last:border-0 hover:bg-slate-50 transition-colors">
                        <td class="px-6 py-4 text-sm font-semibold text-slate-800">@item.Title</td>
                        <td class="px-6 py-4 text-sm text-slate-600">@item.Description</td>
                        <td class="px-6 py-4 text-sm text-slate-600">@item.TechStack</td>

                        <td class="px-6 py-4 text-sm text-right flex justify-end gap-3">
                            <a href="/admin/project/edit?id=@item.ProjectId"
                               class="text-indigo-600 hover:text-indigo-900 font-medium transition-colors">
                                <span class="material-symbols-outlined">edit</span>
                            </a>
                            <form asp-area="admin" asp-controller="Project" asp-action="DeleteProject" asp-route-id="@item.ProjectId" method="post"
                                  onsubmit="return confirm('Are you sure if you want to delete?')"
                                  style="display:inline;">
                                <button type="submit" class="text-red-600 hover:text-red-900 transition-colors bg-transparent border-0 p-0">
                                    <span class="material-symbols-outlined leading-none">delete</span>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="flex justify-end">
        <a href="/Admin/Project/Add" class="bg-purple-600 hover:bg-purple-700 text-white font-medium py-2.5 px-6 rounded-lg transition-colors duration-200 shadow-sm">
            Add Project
        </a>
    </div>

</div>

