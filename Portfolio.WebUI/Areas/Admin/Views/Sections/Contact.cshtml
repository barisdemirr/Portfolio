@model ContactGetDto

@{
    Layout = "~/Areas/Admin/Views/Shared/_PanelLayout.cshtml";
}

<main class="flex-1 overflow-y-auto bg-background-light dark:bg-background-dark p-6 lg:p-10">
    <div class="max-w-5xl mx-auto">
        <!-- Breadcrumb & Header -->
        <div class="mb-8">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h1 class="text-3xl font-bold text-slate-900 dark:text-white">Contact Section Management</h1>
                    <p class="text-slate-500 dark:text-slate-400 mt-1">
                        Update your communication channels, social media links, and how potential clients can get in touch with you.
                    </p>
                </div>
                <div class="flex gap-3">
                    <a asp-controller="home" asp-action="Index" asp-fragment="contact" class="inline-flex items-center gap-2 px-4 py-2 border border-slate-300 dark:border-white/20 rounded-lg text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-white/5 font-medium transition-colors text-sm">
                        <span class="material-icons-outlined text-lg">visibility</span>
                        Preview on Site
                    </a>
                </div>
            </div>
        </div>
        <!-- Content Card -->
        <div class="bg-white dark:bg-[#231631] rounded-xl shadow-sm border border-slate-200 dark:border-white/5 overflow-hidden">

            <div class="px-6 py-4 border-b border-slate-100 dark:border-white/5 flex justify-between items-center bg-slate-50/50 dark:bg-white/[0.02]">
                <span class="text-xs text-slate-400">Last updated: @Model.UpdatedAt</span>
            </div>

            <form class="p-6 space-y-6" asp-area="Admin" asp-controller="Sections" asp-action="Contact" method="post">

                <div class="flex items-center gap-3 mb-6">
                    <input asp-for="OpenToWork" type="checkbox" id="openToWork" 
                           class="w-5 h-5 bg-white dark:bg-[#1a1025] border border-slate-200 dark:border-white/10 rounded focus:ring-2 focus:ring-primary/20 text-primary transition-all duration-200" />
                    <label for="openToWork"
                           class="text-sm font-medium text-slate-700 dark:text-slate-300">
                        Open To Work
                    </label>
                </div>

                <div class="mb-4">
                    <label for="title"
                           class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                        Title
                    </label>
                    <input asp-for="Title" type="text" id="title"
                           class="w-full px-4 py-3 bg-white dark:bg-[#1a1025] border border-slate-200 dark:border-white/10 rounded-xl text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all duration-200" />
                </div>

                <div class="mb-4">
                    <label for="description"
                           class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                        Description
                    </label>
                    <input asp-for="Description" type="text" id="description"
                           class="w-full px-4 py-3 bg-white dark:bg-[#1a1025] border border-slate-200 dark:border-white/10 rounded-xl text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all duration-200" />
                </div>

                <div class="mb-4">
                    <label for="email"
                           class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                        Email
                    </label>
                    <input asp-for="Email" type="text" id="email"
                           class="w-full px-4 py-3 bg-white dark:bg-[#1a1025] border border-slate-200 dark:border-white/10 rounded-xl text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all duration-200" />
                </div>

                <div class="mb-4">
                    <label for="phone"
                           class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                        Phone
                    </label>
                    <input asp-for="Phone" type="text" id="phone"
                           class="w-full px-4 py-3 bg-white dark:bg-[#1a1025] border border-slate-200 dark:border-white/10 rounded-xl text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all duration-200" />
                </div>

                <div class="mb-4">
                    <label for="location"
                           class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                        Location
                    </label>
                    <input asp-for="Location" type="text" id="location"
                           class="w-full px-4 py-3 bg-white dark:bg-[#1a1025] border border-slate-200 dark:border-white/10 rounded-xl text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all duration-200" />
                </div>

                <div class="mb-4">
                    <label for="mapLocation"
                           class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                        Map Location
                    </label>
                    <input asp-for="MapLocation" type="text" id="mapLocation"
                           class="w-full px-4 py-3 bg-white dark:bg-[#1a1025] border border-slate-200 dark:border-white/10 rounded-xl text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all duration-200" />
                </div>

                <div class="mb-4">
                    <label for="mapImageUrl"
                           class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2">
                        Map Image URL
                    </label>
                    <input asp-for="MapImageUrl" type="text" id="mapImageUrl"
                           class="w-full px-4 py-3 bg-white dark:bg-[#1a1025] border border-slate-200 dark:border-white/10 rounded-xl text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all duration-200" />
                </div>

                <div class="pt-4 flex justify-end">
                    <button type="submit"
                            class="px-6 py-2.5 bg-primary text-white font-medium rounded-lg hover:bg-primary/90 focus:ring-4 focus:ring-primary/20 transition-colors">
                        Save Changes
                    </button>
                </div>

            </form>
        </div>

</main>

