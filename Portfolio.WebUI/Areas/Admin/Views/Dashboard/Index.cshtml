@model (int projectNumber, int skillNumber, int socialNumber)

@{
    Layout = "~/Areas/Admin/Views/Shared/_MainLayout.cshtml";
}

<main class="flex-grow max-w-5xl mx-auto mt-32 px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header Section -->
    <div class="mb-10 flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
            <p class="text-sm font-semibold text-primary uppercase tracking-wider mb-1">Overview</p>
            <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 dark:text-white">
                Welcome back, <span class="text-primary">@User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value</span>
            </h1>
            <p class="mt-2 text-slate-500 dark:text-slate-400 max-w-2xl">
                Here's what's happening with your portfolio today.
            </p>
        </div>
    </div>
    <!-- Stats Grid -->
    <div class="grid mt-16 grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
        <!-- Card 1: All Projects -->
        <div class="bg-white dark:bg-slate-800 rounded-xl p-6 shadow-sm border border-slate-100 dark:border-slate-700 hover:shadow-lg hover:shadow-primary/5 hover:border-primary/20 transition-all duration-300 group">
            <div class="flex justify-between items-start mb-4">
                <div class="p-3 bg-primary/10 rounded-lg group-hover:bg-primary group-hover:text-white transition-colors text-primary">
                    <span class="material-icons-round text-2xl">folder_special</span>
                </div>
            </div>
            <h3 class="text-slate-500 dark:text-slate-400 text-sm font-medium">All Projects</h3>
            <div class="flex items-baseline mt-1">
                <p class="text-3xl font-bold text-slate-900 dark:text-white">@Model.projectNumber</p>
                <p class="ml-2 text-sm text-slate-500 dark:text-slate-400">Published</p>
            </div>
        </div>
        <!-- Card 2: All Skills -->
        <div class="bg-white dark:bg-slate-800 rounded-xl p-6 shadow-sm border border-slate-100 dark:border-slate-700 hover:shadow-lg hover:shadow-primary/5 hover:border-primary/20 transition-all duration-300 group">
            <div class="flex justify-between items-start mb-4">
                <div class="p-3 bg-primary/10 rounded-lg group-hover:bg-primary group-hover:text-white transition-colors text-primary">
                    <span class="material-icons-round text-2xl">auto_awesome</span>
                </div>
            </div>
            <h3 class="text-slate-500 dark:text-slate-400 text-sm font-medium">All Skills</h3>
            <div class="flex items-baseline mt-1">
                <p class="text-3xl font-bold text-slate-900 dark:text-white">@Model.skillNumber</p>
                <p class="ml-2 text-sm text-slate-500 dark:text-slate-400">Listed</p>
            </div>
        </div>
        <!-- Card 3: Sections -->
        <div class="bg-white dark:bg-slate-800 rounded-xl p-6 shadow-sm border border-slate-100 dark:border-slate-700 hover:shadow-lg hover:shadow-primary/5 hover:border-primary/20 transition-all duration-300 group">
            <div class="flex justify-between items-start mb-4">
                <div class="p-3 bg-primary/10 rounded-lg group-hover:bg-primary group-hover:text-white transition-colors text-primary">
                    <span class="material-icons-round text-2xl">public</span>
                </div>
            </div>
            <h3 class="text-slate-500 dark:text-slate-400 text-sm font-medium">Social Media</h3>
            <div class="flex items-baseline mt-1">
                <p class="text-3xl font-bold text-slate-900 dark:text-white">@Model.socialNumber</p>
                <p class="ml-2 text-sm text-slate-500 dark:text-slate-400">Accounts</p>
            </div>
        </div>

    </div>
</main>

