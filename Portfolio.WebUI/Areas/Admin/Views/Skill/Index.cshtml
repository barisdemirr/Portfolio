@model List<SkillGetAdminDto>

@{
    Layout = "~/Areas/Admin/Views/Shared/_PanelLayout.cshtml";
}

<div class="max-w-5xl mx-auto">

    <div class="mb-8">
        <h1 class="text-2xl font-semibold text-slate-800">Skills Management</h1>
        <p class="text-slate-500 mt-1">Manage the portfolio skills displayed on your site.</p>
    </div>

    <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden mb-6">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 border-b border-slate-200">
                    <th class="px-6 py-4 text-sm font-medium text-slate-500">Skill</th>
                    <th class="px-6 py-4 text-sm font-medium text-slate-500">Progress</th>
                    <th class="px-6 py-4 text-sm font-medium text-slate-500">Show On Hero</th>
                    <th class="px-6 py-4 text-sm font-medium text-slate-500 text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="border-b border-slate-100 last:border-0 hover:bg-slate-50 transition-colors">
                        <td class="px-6 py-4 text-sm font-semibold text-slate-800">@item.Name</td>
                        <td class="px-6 py-4 text-sm text-slate-600 text-center">@item.ProgressValue</td>
                        <td class="px-6 py-4 text-sm text-primary mx-auto text-xl text-center">@(item.ShowOnHero ? "+" : "-")</td>

                        <td class="px-6 py-4 text-sm text-right flex justify-end gap-3">
                            <a href="/admin/skill/edit?id=@item.SkillId"
                               class="text-indigo-600 hover:text-indigo-900 font-medium transition-colors">
                                <span class="material-symbols-outlined">edit</span>
                            </a>
                            <form asp-area="admin" asp-controller="Skill" asp-action="DeleteSkill" asp-route-id="@item.SkillId" method="post"
                                  onsubmit="return confirm('Are you sure if you want to delete?')"
                                  style="display:inline;">
                                <button type="submit" class="text-red-600 hover:text-red-900 transition-colors bg-transparent border-0 p-0">
                                    <span class="material-symbols-outlined leading-none">delete</span>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="flex justify-end">
        <a href="/Admin/Skill/Add" class="bg-purple-600 hover:bg-purple-700 text-white font-medium py-2.5 px-6 rounded-lg transition-colors duration-200 shadow-sm">
            Add Skill
        </a>
    </div>

</div>

